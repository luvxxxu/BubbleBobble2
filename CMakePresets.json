{
  "version": 5,
  "cmakeMinimumRequired": { "major": 3, "minor": 24, "patch": 0 },
  "configurePresets": [
    {
      "name": "native",
      "displayName": "Host desktop build",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "macos-arm64",
      "inherits": "native",
      "displayName": "macOS Apple Silicon",
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "11.0"
      }
    },
    {
      "name": "windows-x64",
      "displayName": "Windows x64 (Visual Studio)",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/${presetName}"
    }
  ],
  "buildPresets": [
    { "name": "native", "configurePreset": "native", "configuration": "Release", "jobs": 4 },
    { "name": "macos-arm64", "configurePreset": "macos-arm64", "configuration": "Release", "jobs": 4 },
    { "name": "windows-x64", "configurePreset": "windows-x64", "configuration": "Release", "jobs": 4 }
  ],
  "testPresets": [
    { "name": "native", "configurePreset": "native", "configuration": "Release", "output": { "outputOnFailure": true } },
    { "name": "macos-arm64", "configurePreset": "macos-arm64", "configuration": "Release", "output": { "outputOnFailure": true } },
    { "name": "windows-x64", "configurePreset": "windows-x64", "configuration": "Release", "output": { "outputOnFailure": true } }
  ]
}
